+def test_bots_play_whole_adventures(adventure):
+    results = set()
+    for seed in range(12):
+        g = MazmorrasGame.from_options([], {"companions": 3, "adventure": adventure}, rng=random.Random(seed))
+        g.start()
+        for _ in range(3000):
